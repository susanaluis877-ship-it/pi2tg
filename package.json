  "repository": {
    "type": "git",
    "url": "git+https://github.com/susanaluis877-ship-it/pi2tg.git"
  },
  "homepage": "https://github.com/susanaluis877-ship-it/pi2tg#readme",
  "bugs": { "url": "https://github.com/susanaluis877-ship-it/pi2tg/issues" },
